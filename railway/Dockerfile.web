# Public web service for Railway: builds Stremio Web and serves it behind Caddy,
# which also proxies the watch party WebSocket to the room service over Railway's
# private network. Build context is the repository root.

FROM node:22-alpine AS build
WORKDIR /app

# Several dependencies (langs, stremio-translations, the spatial navigation
# polyfill) are GitHub refs, so pnpm shells out to git to fetch them. One
# transitive dependency, vtt.js, is pinned to an ssh:// git URL, which a build
# container has no key for — rewrite those to anonymous HTTPS. The repositories
# are public, so nothing is lost, and the lockfile is untouched because the
# rewrite happens inside git rather than in pnpm's resolution.
RUN apk add --no-cache git \
    && git config --global url."https://github.com/".insteadOf "ssh://git@github.com/" \
    && git config --global url."https://github.com/".insteadOf "git@github.com:"

# The repository requires pnpm 11; corepack's bundled default is older, and the
# engines check would reject it. Pin explicitly rather than relying on the
# builder image's default.
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# The build namespaces assets by commit hash. Railway exposes the commit as an
# environment variable; webpack falls back to it when git is unavailable.
ARG RAILWAY_GIT_COMMIT_SHA
ENV RAILWAY_GIT_COMMIT_SHA=$RAILWAY_GIT_COMMIT_SHA
RUN pnpm build

FROM caddy:2-alpine
COPY railway/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/build /srv/stremio-web

# Railway injects PORT and terminates TLS at its edge.
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
