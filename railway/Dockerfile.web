# Public web service for Railway: builds Stremio Web and serves it behind Caddy,
# which also proxies the watch party WebSocket to the room service over Railway's
# private network. Build context is the repository root.

FROM node:22-alpine AS build
WORKDIR /app

# corepack reads the pinned version from package.json's packageManager field, so
# this container resolves dependencies identically to CI and to a developer
# machine. That matters: a different pnpm resolves the GitHub dependencies to
# ssh:// URLs, which no build container has a key for.
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile

COPY . .

# The build namespaces assets by commit hash. Railway exposes the commit as an
# environment variable; webpack falls back to it when git is unavailable.
ARG RAILWAY_GIT_COMMIT_SHA
ENV RAILWAY_GIT_COMMIT_SHA=$RAILWAY_GIT_COMMIT_SHA
RUN pnpm build

FROM caddy:2-alpine
COPY railway/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/build /srv/stremio-web

# Railway injects PORT and terminates TLS at its edge.
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
