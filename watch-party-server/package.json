        "test": "node --test \"tests/**/*.test.ts\"",
        "start": "node dist/index.js",
        "dev": "node --watch src/index.ts"
    },
    "dependencies": {
        "ws": "8.18.3"
    },
    "devDependencies": {
        "@types/node": "^22.15.3",
        "@types/ws": "^8.18.1",
        "typescript": "^5.9.3"
    }
}
