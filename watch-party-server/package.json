{
    "name": "stremio-watch-party-server",
    "version": "0.1.0",
    "description": "Host-authoritative room service for Stremio Web watch parties. Never proxies media.",
    "license": "gpl-2.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "main": "dist/index.js",
    "scripts": {
