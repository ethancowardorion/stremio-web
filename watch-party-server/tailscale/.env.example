# Copy to .env and fill in. Generate it automatically with:
#
#   ./setup.sh
#
# The origin must match exactly what the browser shows, scheme included.
WATCH_PARTY_ORIGIN=https://your-machine.your-tailnet.ts.net

# Loopback port Caddy binds to. Tailscale Serve forwards to this.
WATCH_PARTY_HTTP_PORT=8123
